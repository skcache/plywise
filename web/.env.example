# These values are public and will be included in the browser bundle.
# Leave both empty when the website and local C++ service share an origin.
VITE_PLYWISE_API_ORIGIN=
VITE_PLYWISE_EVENT_ORIGIN=
# Optional managed account entry (Google and GitHub). Enable those providers in Supabase.
# The publishable key is safe to ship; never use a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
